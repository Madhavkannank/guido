# ─── Multi-Omics Genomic Disease Risk Pipeline Configuration ─────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Primary Clinical Engine Task ─────────────────────────────────────────────
# Task formulation: 3-Year Progression-Free Survival (PFS) & Recurrence Risk
MODEL_TASK=genomic_disease_risk_progression
DATA_SOURCE=xena                      # Primary raw data source: UCSC Xena Hub S3
TIME_HORIZON_DAYS=1095                # 3 Years (1095 days) progression window
MIN_FOLLOWUP_DAYS=730                 # 2 Years (730 days) disease-free follow-up for negative control

# ── Clinical Risk Score Thresholds ───────────────────────────────────────────
# Calibrated multi-tier stratification
RISK_THRESHOLD_LOW=0.35               # < 35% probability = Low Risk (Standard surveillance)
RISK_THRESHOLD_HIGH=0.65              # > 65% probability = High Risk (Intensified surveillance / Adjuvant)

# ── Genomic Feature Space & Hallmark Metagenes ───────────────────────────────
TOTAL_MODEL_FEATURES=100              # Total input dimension to stacking ensemble
N_TOP_DIFFERENTIAL_GENES=88           # High variance & mutual info expression features
N_HALLMARK_METAGENES=12               # Curated MSigDB-derived cancer hallmark axes

# ── Groq LLM (required for /biomarkers and /literature audit endpoints) ──────
# Obtain from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192
GROQ_AUDIT_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.0
GROQ_MAX_TOKENS=1024

# ── NCBI Entrez (required for PubMed clinical literature validation) ─────────
# Must be a real email to comply with NCBI Terms of Service
ENTREZ_EMAIL=your_email@example.com
ENTREZ_API_KEY=your_ncbi_api_key_here
PUBMED_MAX_ABSTRACTS=5

# ── Target Cohort & Organ Grouping ───────────────────────────────────────────
# Options: TCGA-PAN-RENAL, TCGA-PAN-LUNG, TCGA-PAN-GI, TCGA-PAN-HEPATOBILIARY, TCGA-BRCA
DEFAULT_COHORT_GROUP=TCGA-PAN-RENAL

# ── MLflow Tracking ──────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── FastAPI Server ───────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Model Training & Cross-Validation ────────────────────────────────────────
CV_FOLDS=5
RANDOM_SEED=42
TEST_SPLIT_RATIO=0.20

